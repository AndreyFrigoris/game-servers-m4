TZ=UTC
SERVER_NAME="My Conan Server"
# ExiledLands (default) or Siptah. Siptah costs more RAM; try Exiled Lands first.
MAP=ExiledLands
GAME_PORT=7787
QUERY_PORT=27019
MAX_PLAYERS=2
# Join password (also set ServerPassword in ServerSettings.ini). Empty = open.
SERVER_PASSWORD=
# Docker VM on Mac is a generic ARM64 guest — not Asahi. Leave generic.
ARM64_DEVICE=generic
RUN_STEAMCMD=0
